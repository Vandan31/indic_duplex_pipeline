# Copy to .env and fill in. .env is gitignored.
# NVIDIA NIM (build.nvidia.com) — free tier, used for audio verification.
# Only needed for discover/run, not for transcribe.
NVIDIA_API_KEY=nvapi-...
# Hugging Face. Needed for gated pyannote and DialogueSidon weights (discover/
# run), and separately for the gated bodhan-ai/indic-transcribe-core weights
# (transcribe) -- request access to that repo on huggingface.co under the
# same account this token belongs to; if you only need `transcribe`, that's
# the only gated repo you need approved.
HF_TOKEN=hf_...
